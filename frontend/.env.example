# FreshGuard AI Frontend - Environment Configuration
# 
# For local development:
# Leaving this unset or set to http://127.0.0.1:5000 connects to the local Flask server.
VITE_API_URL=http://127.0.0.1:5000

# For production deployment (e.g. Render, Railway, AWS, DigitalOcean):
# Set this to your live deployed backend URL:
# VITE_API_URL=https://freshguard-ai-backend.onrender.com
